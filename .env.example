# Database connection
# SQLite for instant zero-config local run:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/careerloop?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="careerloop-secure-jwt-key-production"

# Google OAuth Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Engine Key (Google Gemini API Key - Optional, system has explainable deterministic engine fallback)
GEMINI_API_KEY=""

# Admin Approval Secret Key (To authorize Government Admin registrations)
ADMIN_REGISTRATION_CODE="CAREERLOOP-GOV-ADMIN"
NEXT_PUBLIC_ADMIN_CODE="CAREERLOOP-GOV-ADMIN"
