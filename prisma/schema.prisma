datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  role             String          @default("TRAINEE") // TRAINEE, EMPLOYER, TRAINING_PROVIDER, GOVERNMENT_ADMIN
  adminApproved    Boolean         @default(false)
  consentGiven     Boolean         @default(false)
  consentTimestamp DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  accounts         Account[]
  sessions         Session[]
  traineeProfile   TraineeProfile?
  employerProfile  EmployerProfile?
  providerProfile  TrainingProviderProfile?
  auditLogs        AuditLog[]
  consentRecords   ConsentRecord[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TraineeProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  traineeId        String          @unique // e.g. CLP-2026-XXXXX
  dateOfBirth      DateTime?
  gender           String?
  district         String
  state            String          @default("National")
  educationLevel   String?
  phone            String?
  bio              String?
  currentStatus    String          @default("TRAINING") // TRAINING, CERTIFIED, EMPLOYED, SELF_EMPLOYED, APPRENTICESHIP, UNEMPLOYED, FURTHER_STUDIES
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           TraineeSkill[]
  skillEvidence    SkillEvidence[]
  enrollments      Enrollment[]
  certifications   Certification[]
  employmentRecords EmploymentRecord[]
  selfEmployments  SelfEmploymentRecord[]
  apprenticeships  ApprenticeshipRecord[]
  followUps        FollowUp[]
  nonPlacements    NonPlacementRecord[]
  assessments      Assessment[]
  careerTarget     CareerTarget?
  projects         Project[]
  externalProfiles ExternalProfile[]
  applications     Application[]
  compensationHistory CompensationHistory[]
  roadmap             UserRoadmap?
}

model CareerTarget {
  id               String         @id @default(cuid())
  traineeId        String         @unique
  targetRole       String
  industry         String?
  preferredLocations String?      // comma-separated
  targetSalaryMin  Int?
  targetSalaryMax  Int?
  employmentType   String?        @default("FULL_TIME")
  experienceLevel  String?        @default("ENTRY")
  targetDate       DateTime?
  priority         String         @default("HIGH")
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  trainee          TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Project {
  id           String         @id @default(cuid())
  traineeId    String
  title        String
  description  String?
  techStack    String?        // comma-separated skills
  url          String?
  repoUrl      String?
  startDate    DateTime?
  endDate      DateTime?
  isHighlighted Boolean       @default(false)
  createdAt    DateTime       @default(now())

  trainee      TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model ExternalProfile {
  id           String         @id @default(cuid())
  traineeId    String
  platform     String         // GITHUB, LEETCODE, CODECHEF, LINKEDIN, PORTFOLIO
  username     String?
  profileUrl   String?
  accessToken  String?        // encrypted
  isConnected  Boolean        @default(false)
  lastSyncedAt DateTime?
  rawData      String?        // JSON cache of fetched data
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  trainee      TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@unique([traineeId, platform])
}

// ─── SKILL EVIDENCE ENGINE ─────────────────────────────────────────────────

model SkillEvidence {
  id               String         @id @default(cuid())
  traineeId        String
  skillId          String
  sourceType       String         // RESUME, PROJECT, TRAINING, ASSESSMENT, CERTIFICATION, GITHUB, LEETCODE, EMPLOYER, SELF_DECLARED, OTHER
  sourceId         String?        // FK to enrollment/certification/project/assessment id
  evidenceUrl      String?
  description      String?
  verificationStatus String       @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  confidenceLevel  String         @default("LOW")        // LOW, MEDIUM, HIGH, VERY_HIGH
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  trainee          TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

// ─── CAREER PATHS & ROADMAPS ──────────────────────────────────────────────

model SkillRelationship {
  id             String   @id @default(cuid())
  skillId        String
  relatedSkillId String
  relationshipType String // PREREQUISITE, COMPLEMENTARY, LEADS_TO

  skill         Skill    @relation("SkillRelationships", fields: [skillId], references: [id], onDelete: Cascade)
  relatedSkill  Skill    @relation("RelatedSkillRelationships", fields: [relatedSkillId], references: [id], onDelete: Cascade)

  @@unique([skillId, relatedSkillId])
}

model CareerPath {
  id          String   @id @default(cuid())
  title       String   @unique
  category    String   // Technology, Healthcare, Business, Design, etc.
  description String?
  avgSalaryMin Int?
  avgSalaryMax Int?
  demandLevel  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, VERY_HIGH
  createdAt   DateTime @default(now())

  requirements CareerRequirement[]
}

model CareerRequirement {
  id           String   @id @default(cuid())
  careerPathId String
  skillId      String
  importance   String   @default("REQUIRED") // REQUIRED, RECOMMENDED, OPTIONAL
  minLevel     String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT

  careerPath   CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerPathId, skillId])
}

model UserRoadmap {
  id           String         @id @default(cuid())
  traineeId    String         @unique
  careerPathId String?
  generatedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  trainee      TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  items        RoadmapItem[]
}

model RoadmapItem {
  id          String      @id @default(cuid())
  roadmapId   String
  skillId     String?
  phase       Int         @default(1)
  title       String
  description String?
  itemType    String      @default("SKILL") // SKILL, PROJECT, ASSESSMENT, CERTIFICATION, MILESTONE
  status      String      @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  orderIndex  Int         @default(0)
  reasoning   String?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  roadmap     UserRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill       Skill?      @relation(fields: [skillId], references: [id], onDelete: SetNull)
}

// ─── EMPLOYER ─────────────────────────────────────────────────────────────

model EmployerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  industry           String
  district           String
  state              String             @default("National")
  companySize        String?
  website            String?
  contactEmail       String
  isVerified         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedEmployments EmploymentRecord[]
  jobs               Job[]
}

// ─── TRAINING PROVIDER ────────────────────────────────────────────────────

model TrainingProviderProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  institutionName     String
  accreditationNumber String?
  centerType          String            @default("Vocational Skill Center")
  district            String
  state               String            @default("National")
  contactEmail        String
  isVerified          Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programs            TrainingProgram[]
}

model TrainingProgram {
  id             String                  @id @default(cuid())
  providerId     String
  title          String
  code           String                  @unique
  sector         String
  description    String
  durationWeeks  Int
  minHours       Int
  status         String                  @default("ACTIVE")
  skillsOffered  String?                 // comma-separated skill names
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  provider       TrainingProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  courses        Course[]
  enrollments    Enrollment[]
  certifications Certification[]
  nonPlacements  NonPlacementRecord[]
}

model Course {
  id              String          @id @default(cuid())
  programId       String
  title           String
  level           String          @default("Foundation")
  description     String
  curriculum      String?
  requiredPrereqs String?

  program         TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id                   String          @id @default(cuid())
  traineeId            String
  programId            String
  enrollmentDate       DateTime        @default(now())
  completionDate       DateTime?
  attendancePercentage Float?          // null until tracked — no fake default
  status               String          @default("ENROLLED") // ENROLLED, IN_PROGRESS, COMPLETED, DROPPED, FAILED
  grade                String?
  createdAt            DateTime        @default(now())

  trainee              TraineeProfile  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  program              TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  assessments          Assessment[]
}

model Assessment {
  id             String         @id @default(cuid())
  enrollmentId   String
  traineeId      String
  title          String
  assessmentDate DateTime       @default(now())
  maxScore       Float          @default(100.0)
  scoreObtained  Float
  passed         Boolean        @default(false)
  feedback       String?
  createdAt      DateTime       @default(now())

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  trainee        TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Certification {
  id                String          @id @default(cuid())
  traineeId         String
  programId         String
  certificateNumber String          @unique
  credentialUrl     String?
  issueDate         DateTime        @default(now())
  expiryDate        DateTime?
  issuingAuthority  String          @default("National Skill Development Board")
  verificationStatus String         @default("UPLOADED") // UPLOADED, PENDING_VERIFICATION, PROVIDER_VERIFIED, VERIFIED, REJECTED, EXPIRED
  verificationNotes String?
  verifiedAt        DateTime?
  createdAt         DateTime        @default(now())

  trainee           TraineeProfile  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  program           TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
}

// ─── SKILLS ───────────────────────────────────────────────────────────────

model Skill {
  id           String         @id @default(cuid())
  name         String         @unique
  category     String         // Technical, Soft Skill, Domain
  standardCode String?
  description  String?

  traineeSkills  TraineeSkill[]
  skillEvidence  SkillEvidence[]
  jobRequirements JobSkillRequirement[]
  skillRelationships    SkillRelationship[] @relation("SkillRelationships")
  relatedBySkills       SkillRelationship[] @relation("RelatedSkillRelationships")
  careerRequirements    CareerRequirement[]
  roadmapItems          RoadmapItem[]
}

model TraineeSkill {
  id                   String         @id @default(cuid())
  traineeId            String
  skillId              String
  proficiencyLevel     String         @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  verificationStatus   String         @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED
  verifiedByAssessment Boolean        @default(false)
  verifiedByEmployer   Boolean        @default(false)
  addedAt              DateTime       @default(now())

  trainee              TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  skill                Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([traineeId, skillId])
}

// ─── EMPLOYMENT ───────────────────────────────────────────────────────────

model EmploymentRecord {
  id                   String           @id @default(cuid())
  traineeId            String
  employerId           String?
  companyName          String
  jobTitle             String
  locationDistrict     String
  locationState        String           @default("National")
  monthlySalary        Int
  employmentType       String           @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP, FREELANCE
  startDate            DateTime
  endDate              DateTime?
  isCurrent            Boolean          @default(true)
  skillRelevanceScore  Int?             // null until reported — no fake default
  verificationStatus   String           @default("SELF_REPORTED") // SELF_REPORTED, PENDING_VERIFICATION, EMPLOYER_VERIFIED, REJECTED
  verificationNotes    String?
  verifiedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  trainee              TraineeProfile   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  employer             EmployerProfile? @relation(fields: [employerId], references: [id], onDelete: SetNull)
}

model CompensationHistory {
  id           String         @id @default(cuid())
  traineeId    String
  monthlySalary Int
  recordedAt   DateTime       @default(now())
  source       String         @default("SELF_REPORTED") // SELF_REPORTED, EMPLOYER_VERIFIED, FOLLOWUP
  notes        String?

  trainee      TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model SelfEmploymentRecord {
  id               String         @id @default(cuid())
  traineeId        String
  businessName     String
  businessType     String         // Retail, Services, Manufacturing, Digital Freelancing
  sector           String
  startDate        DateTime
  monthlyNetIncome Int
  employeesHired   Int            @default(0)
  skillsApplied    String?
  businessStatus   String         @default("ACTIVE") // ACTIVE, SCALING, PAUSED, CLOSED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  trainee          TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model ApprenticeshipRecord {
  id                 String         @id @default(cuid())
  traineeId          String
  hostOrganization   String
  tradeRole          String
  stipendAmount      Int
  startDate          DateTime
  endDate            DateTime?
  isCompleted        Boolean        @default(false)
  offeredFullTimeJob Boolean        @default(false)
  skillsAcquired     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  trainee            TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

// ─── JOBS & APPLICATIONS ──────────────────────────────────────────────────

model Job {
  id              String         @id @default(cuid())
  employerId      String
  title           String
  description     String
  industry        String
  locationDistrict String
  locationState   String         @default("National")
  salaryMin       Int?
  salaryMax       Int?
  employmentType  String         @default("FULL_TIME")
  experienceLevel String         @default("ENTRY") // ENTRY, MID, SENIOR
  educationRequired String?
  status          String         @default("OPEN") // OPEN, CLOSED, FILLED, PAUSED
  deadline        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employer        EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  skillRequirements JobSkillRequirement[]
  applications    Application[]
}

model JobSkillRequirement {
  id         String   @id @default(cuid())
  jobId      String
  skillId    String
  required   Boolean  @default(true) // true = required, false = preferred
  minLevel   String   @default("INTERMEDIATE")

  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model Application {
  id          String         @id @default(cuid())
  traineeId   String
  jobId       String
  status      String         @default("APPLIED") // APPLIED, SHORTLISTED, INTERVIEW_SCHEDULED, OFFER_MADE, ACCEPTED, REJECTED, WITHDRAWN
  appliedAt   DateTime       @default(now())
  notes       String?
  updatedAt   DateTime       @updatedAt

  trainee     TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([traineeId, jobId])
}

// ─── FOLLOW-UP ENGINE ─────────────────────────────────────────────────────

model FollowUp {
  id                     String         @id @default(cuid())
  traineeId              String
  milestoneDays          Int            // 30, 90, 180, 365
  scheduledDate          DateTime
  completedDate          DateTime?
  isCompleted            Boolean        @default(false)
  isEmployed             Boolean?
  employmentType         String?
  companyName            String?
  jobTitle               String?
  currentSalary          Int?
  sameEmployerAsPlacement Boolean?
  skillRelevanceScore    Int?           // 1 to 5
  promotionReceived      Boolean?
  wageIncreasePercent    Float?
  trainingRelevance      String?        // VERY_RELEVANT, RELEVANT, PARTIALLY_RELEVANT, NOT_RELEVANT
  nonPlacementReason     String?
  nonPlacementNotes      String?
  feedback               String?
  createdAt              DateTime       @default(now())

  trainee                TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model NonPlacementRecord {
  id             String           @id @default(cuid())
  traineeId      String
  programId      String?
  primaryReason  String           // SKILL_GAP, LACK_OF_LOCAL_JOBS, SALARY_MISMATCH, COMMUNICATION_SKILLS, LOCATION_MOBILITY, FURTHER_EDUCATION, PERSONAL_REASON, OTHER
  details        String?
  recordedAt     DateTime         @default(now())

  trainee        TraineeProfile   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  program        TrainingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
}

// ─── AI & INTELLIGENCE ────────────────────────────────────────────────────

model AIInsight {
  id               String   @id @default(cuid())
  targetType       String   // TRAINEE, COURSE, DISTRICT, PROVIDER, POLICY
  targetId         String
  insightType      String   // SKILL_GAP, RISK_ALERT, CAREER_PATH, POLICY_RECOMMENDATION, WAGE_BENCHMARK
  title            String
  score            Float?
  explanation      String
  recommendations  String?  // JSON string
  modelVersion     String?
  confidence       String?  // LOW, MEDIUM, HIGH
  dataFreshness    DateTime @default(now())
  createdAt        DateTime @default(now())
}

model PolicyRecommendation {
  id                String   @id @default(cuid())
  district          String?
  sector            String?
  priority          String   @default("HIGH") // HIGH, MEDIUM, LOW
  issueSummary      String
  recommendedAction String
  dataEvidence      String
  expectedImpact    String?
  confidence        String   @default("MEDIUM")
  status            String   @default("OPEN") // OPEN, UNDER_REVIEW, IMPLEMENTED
  createdAt         DateTime @default(now())
}

// ─── CONSENT & AUDIT ──────────────────────────────────────────────────────

model ConsentRecord {
  id                String   @id @default(cuid())
  userId            String
  purpose           String
  dataFieldsGranted String
  ipAddress         String?
  userAgent         String?
  grantedAt         DateTime @default(now())
  revokedAt         DateTime?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  role           String?
  action         String
  targetEntity   String
  targetEntityId String?
  metadata       String?  // JSON string
  ipAddress      String?
  before         String?  // JSON string of previous state
  after          String?  // JSON string of new state
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
